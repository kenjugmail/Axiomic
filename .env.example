# Axiomic — environment variables.
#
# Copy this file to `.env` and edit the values. Variables marked
# REQUIRED-IN-PROD must be set before public deploy; OPTIONAL ones
# have sensible defaults for local dev.

# === Runtime ===

# OPTIONAL — listen port. Default 3000.
PORT=3000

# OPTIONAL — runtime mode. One of: development | production | test.
# Default: development. Production toggles security warnings + disables
# DEV_AUTH_BYPASS regardless of its value.
NODE_ENV=development

# REQUIRED-IN-PROD — comma-separated list of allowed CORS origins for
# the API. Default `http://localhost:5173` works for local Vite dev.
# Multi-origin example: https://app.example.com,https://staging.example.com
CORS_ORIGIN=http://localhost:5173

# === Storage ===

# OPTIONAL — SQLite database path. Default in-memory or `./axiomic.db`
# depending on how the migration runner is invoked.
DATABASE_URL=./axiomic.db

# OPTIONAL — directory where uploaded files land. Default
# `<cwd>/uploads`. Set to a persistent volume on PaaS deploys with
# ephemeral local disks.
# UPLOADS_STORAGE_PATH=/var/lib/axiomic/uploads

# === Session ===

# REQUIRED-IN-PROD — strong random value used to sign sessions.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# === Auth ===

# OPTIONAL — when set to "1" AND NODE_ENV is not production, every
# request is auto-authed as DEV_AUTH_BYPASS_USER. Convenient for local
# demos without signup/login. Has no effect in production.
# DEV_AUTH_BYPASS=1
# DEV_AUTH_BYPASS_USER=alice

# OPTIONAL — username promoted to admin role on first server boot if
# no admin exists yet. Required only if you want the admin reindex /
# moderation surfaces accessible.
# BOOTSTRAP_ADMIN_USERNAME=alice

# === Signing (capstone transcripts) ===

# REQUIRED-IN-PROD — 32-byte hex-encoded ed25519 seed. Without this,
# every restart generates a new ephemeral key and previously-issued
# transcripts STOP VERIFYING. Generate one with:
#   bash scripts/generate-signing-key.sh
# Treat it like a secret; never commit.
# AXIOMIC_SIGNING_PRIVATE_KEY_HEX=

# === AI Provider ===

# OPTIONAL — "mock" (default, canned responses, no API keys) or
# "ollama" (local LLM via Ollama).
AI_PROVIDER=mock

# Ollama settings (only used when AI_PROVIDER=ollama).
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# === Server-side code execution (Sprint 44 stub + Sprint 46 local backend) ===

# OPTIONAL — "stub" (default, returns not_enabled) or "local" (Bun.spawn-
# based local-process executor). Use "local" only on trusted-user
# deploys; arbitrary public input requires a sandboxed runtime
# (Docker/gVisor/firejail).
SERVER_EXEC_BACKEND=stub

# OPTIONAL — wall-clock timeout per server-exec run. Default 30000ms.
SERVER_EXEC_TIMEOUT_MS=30000

# OPTIONAL — max stdout+stderr bytes; output is truncated past this.
# Default 1048576 (1 MB).
SERVER_EXEC_MAX_OUTPUT_BYTES=1048576

# === Content approval gate (Sprint 52) ===

# OPTIONAL — when "1", lesson publishes (and, in follow-up sprints,
# news + wiki edits) route through content_proposals and require
# admin approval before landing. Off by default; tests + dev keep
# publish-immediately. An admin proposer auto-approves their own
# proposal so admins stay productive.
# CONTENT_APPROVAL_ENABLED=1

# === Logging (Sprint 53) ===

# OPTIONAL — structured-logger level. One of:
#   debug | info | warn | error
# Defaults to 'info' in production, 'debug' otherwise.
# LOG_LEVEL=info

# === Digital SAT — Desmos calculator (web bundle) ===

# OPTIONAL — Desmos calculator API key for the on-screen calculator
# panel during math sections. When unset, the panel renders an inline
# 'Calculator unavailable' message and the rest of the exam works
# normally. Free educational keys: https://www.desmos.com/api
# VITE_DESMOS_API_KEY=
