{
  "name": "@axiomic/server",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "DATABASE_URL=\"$(mktemp -t axiomic-test.XXXXXX.db)\" DISABLE_JOB_RUNNER=1 bash -c 'bun run --filter @axiomic/db migrate >/dev/null && bun run --filter @axiomic/db seed >/dev/null && bun test; rm -f \"$DATABASE_URL\" \"$DATABASE_URL-shm\" \"$DATABASE_URL-wal\"'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axiomic/ai": "workspace:*",
    "@axiomic/db": "workspace:*",
    "@axiomic/types": "workspace:*",
    "@hono/zod-validator": "^0.3.0",
    "@sentry/node": "^10.52.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.6.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/web-push": "^3.6.4"
  }
}
