{
  "name": "axiomic",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:mock": "bun run --filter '@axiomic/server' dev & bun run --filter '@axiomic/web' dev & wait",
    "dev:server": "bun run --filter '@axiomic/server' dev",
    "dev:web": "bun run --filter '@axiomic/web' dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "audit:mobile": "bash scripts/lighthouse-audit.sh",
    "audit:lessons": "bun run scripts/audit-lessons.ts",
    "snapshot:quality": "bun run scripts/snapshot-quality.ts",
    "dupes:lessons": "bun run scripts/dupes-lessons.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "db:migrate": "bun run --filter @axiomic/db migrate",
    "db:seed": "bun run --filter @axiomic/db seed",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.48.0",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "axe-core": "^4.11.4",
    "eslint": "^9.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
